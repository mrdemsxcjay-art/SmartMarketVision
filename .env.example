# ---------------------------------------------------------------------------
# SMART MARKET VISION - example configuration.
# Copy to .env and adjust. NEVER commit the real .env (it holds secrets).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------- application
APP_ENV=development              # development | production | test
LOG_LEVEL=INFO                   # CRITICAL | ERROR | WARNING | INFO | DEBUG
API_HOST=0.0.0.0                 # 0.0.0.0 so a phone on the same network can reach it
API_PORT=8000

# ------------------------------------------------------------------- database
# SQLite for Phase 1. A relative sqlite path is resolved from the project root,
# so the same file is used whatever the working directory.
# PostgreSQL later: change only this line, e.g.
# postgresql+psycopg://user:password@localhost:5432/smart_market_vision
DATABASE_URL=sqlite+pysqlite:///data/smart_market_vision.db
DATABASE_RETENTION_DAYS=120

# ---------------------------------------------------------------- market data
# yahoo   = real Forex data, no API key required (default)
# disabled = explicit "no live feed": the UI then reports DATA UNAVAILABLE
MARKET_DATA_PROVIDER=yahoo
PROVIDER_TIMEOUT_SECONDS=12
PROVIDER_MAX_RETRIES=3
PROVIDER_BACKOFF_SECONDS=0.5

# cache TTL per timeframe in seconds (protects the upstream provider)
CACHE_TTL_M5=20
CACHE_TTL_M15=30
CACHE_TTL_H1=90
CACHE_TTL_H4=240
CACHE_TTL_D1=900

# -------------------------------------------------------------------- scanner
SCANNER_ENABLED=true
SCANNER_TICK_SECONDS=15
SCANNER_WATCH_ALL=true
SCANNER_DEFAULT_TIMEFRAME=M15
SCANNER_BARS=400

# -------------------------------------------------------------------- symbols
WATCHLIST=EURUSD,GBPUSD,USDJPY,USDCHF,AUDUSD,USDCAD,NZDUSD,EURGBP,EURJPY,GBPJPY

# ------------------------------------------------------------------- telegram
# Optional. Leave empty and the app runs normally with TELEGRAM = NOT_CONFIGURED.
# Never commit real values. Get a token from @BotFather, the chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# ------------------------------------------------------------------------ API
# "*" is convenient in development; restrict it in production, e.g.
# CORS_ORIGINS=http://localhost:5173,http://192.168.1.20:5173
CORS_ORIGINS=*
MAX_CANDLES_PER_REQUEST=2000
STREAM_HEARTBEAT_SECONDS=20

# ----------------------------------------------------------- confluence (P5)
# Concentrated parameters of the confluence engine. One dimension earns its weight
# ONCE, whatever the number of events behind it; contradictions deduct points.
CONFLUENCE_ENABLED=true
CONFLUENCE_WINDOW_BARS=6            # max bar distance between two aligned events
CONFLUENCE_MAX_AGE_BARS=24          # an older event never participates
CONFLUENCE_VALIDITY_BARS=30         # a confluence without a fresh reading expires
CONFLUENCE_PRICE_BAND_ATR=1.5       # max price distance, in ATR
CONFLUENCE_MIN_EVENTS=2             # below this: NO_CONFLUENCE
CONFLUENCE_WATCH_SCORE=3
CONFLUENCE_CONFLUENCE_SCORE=5
CONFLUENCE_STRONG_SCORE=7

# ---------------------------------------------------------- opportunities (P6)
# BUY / SELL are ANALYTICAL directions observed - never an order. A direction is
# named only when structure, several independent dimensions and the score agree,
# and when no major reading opposes them; otherwise WATCH or NO_TRADE + reason.
OPPORTUNITY_ENABLED=true
OPPORTUNITY_MIN_SCORE=7.0
OPPORTUNITY_MIN_DIMENSIONS=4
OPPORTUNITY_MIN_EVENTS=3
OPPORTUNITY_MAX_CONTRADICTIONS=0
OPPORTUNITY_WATCH_SCORE=5.0
OPPORTUNITY_VALIDITY_BARS=30
OPPORTUNITY_CONFIRM_BARS=3
OPPORTUNITY_COOLDOWN_SECONDS=900

# -------------------------------------------------------------- telegram (P8)
# The token lives HERE and nowhere else: never in the code, the logs, the reports,
# the dashboard or the captures. Leave the two values empty and the app runs with
# TELEGRAM = NOT_CONFIGURED (alerts stay queued, nothing is lost).
TELEGRAM_MODE=DRY_RUN
TELEGRAM_SEND_NO_TRADE=false
TELEGRAM_SEND_CAPTURE=true
TELEGRAM_MAX_ATTEMPTS=5
TELEGRAM_BACKOFF_SECONDS=5
TELEGRAM_POLL_SECONDS=1.5
